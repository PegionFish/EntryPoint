# Maintainer: EntryPoint Community
pkgname=entrypoint-server
pkgver=0.1.0
pkgrel=1
pkgdesc="EntryPoint 服务器 — AI 模块编排平台 daemon + WebUI"
arch=('x86_64')
url="https://github.com/PegionFish/EntryPoint"
license=('MIT')

depends=('gcc-libs' 'fontconfig')
makedepends=('rust' 'npm')
optdepends=(
    'nvidia-utils: CUDA GPU 支持'
    'ffmpeg: 视频/音频处理'
    'uv: Python 环境管理'
)

source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"

    # Rust daemon
    cargo build --release --locked -p ep-daemon

    # WebUI 前端
    cd crates/ep-webui/frontend
    npm ci
    npm run build
}

package() {
    cd "$srcdir/$pkgname-$pkgver"

    # /opt/entrypoint 布局（与 resolve_root 匹配）
    install -dm755 "$pkgdir/opt/entrypoint/bin" \
        "$pkgdir/opt/entrypoint/config/pipelines" \
        "$pkgdir/opt/entrypoint/modules" \
        "$pkgdir/opt/entrypoint/workspace" \
        "$pkgdir/opt/entrypoint/webui"

    install -Dm755 target/release/ep-daemon "$pkgdir/opt/entrypoint/bin/ep-daemon"

    # 配置与模块
    install -Dm644 config/*.toml "$pkgdir/opt/entrypoint/config/" 2>/dev/null || true
    install -Dm644 config/pipelines/*.toml "$pkgdir/opt/entrypoint/config/pipelines/" 2>/dev/null || true
    cp -r modules/* "$pkgdir/opt/entrypoint/modules/" 2>/dev/null || true
    find "$pkgdir/opt/entrypoint/modules" -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true

    # WebUI 静态文件
    cp -r crates/ep-webui/static/* "$pkgdir/opt/entrypoint/webui/" 2>/dev/null || true

    # systemd 服务（EP_ROOT 指向 /opt/entrypoint）
    install -Dm644 packaging/entrypoint.service "$pkgdir/usr/lib/systemd/system/entrypoint.service"

    # /usr/bin 包装器（注入 EP_ROOT）
    cat > "$pkgdir/usr/bin/ep-daemon" <<'EOF'
#!/bin/sh
export EP_ROOT=/opt/entrypoint
exec /opt/entrypoint/bin/ep-daemon "$@"
EOF
    chmod 755 "$pkgdir/usr/bin/ep-daemon"

    # License
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
